<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- "All files access". Optional: the app works without it through the
         folder picker. Note: Google Play restricts this permission. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Android 9 and 10 use the classic storage permissions for the file manager. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- Keeps long jobs alive in the background and shows their progress. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:requestLegacyExternalStorage="true"
        android:allowBackup="true"
        android:label="SevenZip"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" for archives from file managers, browsers, mail... -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/vnd.rar" />
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/gzip" />
                <data android:mimeType="application/x-gzip" />
                <data android:mimeType="application/x-bzip2" />
                <data android:mimeType="application/x-xz" />
            </intent-filter>

            <!-- Same, for apps that hand over a generic type but a telling name. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="*/*" />
                <data android:pathPattern=".*\\.7z" />
                <data android:pathPattern=".*\\.rar" />
                <data android:pathPattern=".*\\.tar" />
                <data android:pathPattern=".*\\.tgz" />
                <data android:pathPattern=".*\\.txz" />
                <data android:pathPattern=".*\\.xz" />
                <data android:pathPattern=".*\\.bz2" />
                <data android:pathPattern=".*\\.gz" />
            </intent-filter>

            <!-- "Share" an archive to this app. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-7z-compressed" />
                <data android:mimeType="application/x-rar-compressed" />
                <data android:mimeType="application/x-tar" />
                <data android:mimeType="application/gzip" />
            </intent-filter>
        </activity>

        <service
            android:name=".JobService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Lets other apps read files this app unpacks for "Open" / "Share". -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
